{
  "integration_version": "atlas.integration.v0.1",
  "name": "LAM-JEPA frozen ARC protocol-v3 reproduction",
  "repository": "vertex-studyAI/LAM-JEPA",
  "source_ref": "0e9eb4f5aad655f01fab71f4c1670899601fceae",
  "mode": "reproduction",
  "scientific_boundary": {
    "retained_verdict": "VALID_NEGATIVE_OR_INCONCLUSIVE_VALIDATION",
    "allow_result_rescue": false,
    "allow_test_split": false,
    "allowed_splits": ["train", "validation"],
    "new_hypotheses_require_new_protocol": true
  },
  "environment": {
    "python": "3.11",
    "install": "python -m pip install -e '.[external-benchmarks]'"
  },
  "dataset": {
    "manifest": "data/manifests/arc_challenge.json",
    "download_command": "python scripts/data/download_arc_challenge.py --splits train validation --out-dir ci-evidence/arc-data",
    "forbidden_artifact": "ci-evidence/arc-data/arc-challenge-test.parquet"
  },
  "protocol_preflight": "python scripts/ci/verify_arc_protocol_v3.py --protocol protocols/arc_challenge_v3.json --dataset-manifest data/manifests/arc_challenge.json --report ci-evidence/arc-protocol-v3-verification.json",
  "producer": {
    "command": "python scripts/benchmark/run_arc_protocol_v3_controls.py --train ci-evidence/arc-data/arc-challenge-train.parquet --validation ci-evidence/arc-data/arc-challenge-validation.parquet --seeds 1 2 3 4 5 --epochs 20 --batch-size 32 --learning-rate 0.0003 --model-steps 1 --train-limit 0 --validation-limit 0 --device cpu --out ci-evidence/arc-protocol-v3-full-controls-validation.json",
    "seeds": [1, 2, 3, 4, 5],
    "epochs": 20,
    "batch_size": 32,
    "learning_rate": 0.0003,
    "model_steps": 1,
    "device": "cpu"
  },
  "verifier": {
    "command": "python scripts/ci/verify_arc_protocol_v3_full_controls.py --results ci-evidence/arc-protocol-v3-full-controls-validation.json --protocol protocols/arc_challenge_v3.json --train ci-evidence/arc-data/arc-challenge-train.parquet --validation ci-evidence/arc-data/arc-challenge-validation.parquet --report ci-evidence/arc-protocol-v3-full-controls-validation-verification.json"
  },
  "executor_contract": [
    "record source SHA before execution",
    "create a fresh output directory rather than overwriting retained evidence",
    "never download or inspect ARC test for the frozen validation protocol",
    "preserve raw outputs even when verification fails",
    "run the independent verifier after the producer",
    "classify the result according to the frozen protocol rather than desired direction",
    "report commands, exit codes, hashes, artifacts, blockers, and current scientific truth"
  ]
}
